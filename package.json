{
  "name": "task-manager",
  "version": "0.1.0",
  "description": "Markdown-native task management, queries, planning, and opt-in integrations for Obsidian.",
  "author": "Mark Feinstein",
  "license": "MIT",
  "private": true,
  "repository": "https://github.com/markfeinstein/obsidian-task-manager",
  "homepage": "https://github.com/markfeinstein/obsidian-task-manager",
  "bugs": "https://github.com/markfeinstein/obsidian-task-manager/issues",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10 <12"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:styles": "node scripts/build-styles.mjs",
    "build:prod": "node esbuild.config.mjs --prod",
    "analyze:bundle": "node esbuild.config.mjs --prod --analyze",
    "experiment:bundles": "node scripts/experiment-optional-bundles.mjs --write",
    "deploy": "node esbuild.config.mjs --prod && node scripts/deploy.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-architecture.mjs && node scripts/check-module-debt.mjs && node scripts/check-lint-baseline.mjs && node scripts/check-ui-literals.mjs && node scripts/check-style-debt.mjs && node scripts/check-style-structure.mjs && node scripts/check-debt-plan.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "lint:eslint": "eslint src scripts *.mjs tests/**/*.mjs tests/**/*.ts",
    "lint:baseline:update": "node scripts/check-lint-baseline.mjs --update",
    "lint:ui-baseline:update": "node scripts/check-ui-literals.mjs --update",
    "lint:style-baseline:update": "node scripts/check-style-debt.mjs --update",
    "lint:style-structure:update": "node scripts/check-style-structure.mjs --update",
    "lint:changed": "node scripts/lint-changed.mjs",
    "lint:fix": "eslint src scripts *.mjs tests/**/*.mjs tests/**/*.ts --fix",
    "test": "node scripts/run-tests.mjs",
    "test:build": "node scripts/run-tests.mjs --build-only",
    "test:coverage": "node scripts/run-tests.mjs --coverage",
    "test:a11y": "node scripts/run-tests.mjs tests/accessibility-dom.test.ts",
    "benchmark": "node --expose-gc scripts/run-benchmarks.mjs",
    "benchmark:full": "node --expose-gc scripts/run-benchmarks.mjs --full",
    "docs:commands": "node scripts/generate-command-reference.mjs",
    "docs:settings": "node scripts/generate-settings-reference.mjs",
    "sample:seed": "node scripts/seed-sample-vault.mjs",
    "smoke:desktop": "node scripts/obsidian-desktop-smoke.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "check:package": "node scripts/check-mobile-graph.mjs && node scripts/check-package.mjs",
    "check:initial-release": "node scripts/check-ga-evidence.mjs --initial-submission",
    "check:ga-evidence": "node scripts/check-ga-evidence.mjs",
    "package:release": "node scripts/package-release.mjs",
    "package:release:working-tree": "node scripts/package-release.mjs --working-tree",
    "check:release": "node scripts/check-release.mjs",
    "mcp:companion": "node scripts/mcp-companion.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@cyclonedx/cyclonedx-library": "10.1.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.19.19",
    "adm-zip": "0.6.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "ajv-formats-draft2019": "1.6.1",
    "axe-core": "4.14.0",
    "esbuild": "0.25.12",
    "ical.js": "2.2.1",
    "jsdom": "26.1.0",
    "obsidian": "1.14.4",
    "terser": "5.49.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
